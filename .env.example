# Copy to .env for local development. Never commit real values.

# Connection used by the API at runtime (later milestones introduce a least-privilege app role).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/scanin_dev

# Admin connection used ONLY by tests to create and drop throwaway databases.
# Must point at a maintenance database (e.g. "postgres") on a LOCAL or CI server, never a shared one.
# The role needs CREATEDB and CREATEROLE. URL-encode special characters in the password.
TEST_DATABASE_ADMIN_URL=postgres://USER:PASSWORD@localhost:5432/postgres

API_PORT=3000

# Exact origin of the web app. Used for CSRF checks and links in e-mails.
APP_ORIGIN=http://localhost:5173

# Secret for hashing IP addresses before storage / rate limiting. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=

# QR signing keys: "kid:key,kid2:key2". Each key is 32+ random bytes, base64url.
# Generate: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64url'))"
# Rotate by adding a new key, switching QR_ACTIVE_KID, and removing the old key >= 4 minutes later.
QR_KEYS=
QR_ACTIVE_KID=k1

# How long a QR code stays usable, in seconds (5-120, default 15). Short by design so a relayed code
# is useful for seconds, not minutes. The projector refreshes this often and check-in also accepts
# the immediately previous code, so the real acceptance window is up to twice this.
QR_TOKEN_TTL_SECONDS=15

# E-mail via Resend. Required in production. In development, leave unset to print links to the console.
RESEND_API_KEY=
MAIL_FROM=

# Per-address limits (optional). Campus Wi-Fi puts a whole class behind one address, so sign-ups are
# generous by default. Failed sign-ins are also counted per account (5), which is the main guard.
REGISTER_MAX_PER_IP_PER_HOUR=100
LOGIN_MAX_FAILURES_PER_IP=30

# Anti-proxy controls (all optional; these are the defaults).
# Headcount reconciliation flags attendance for REVIEW when it exceeds the lecturer's headcount by
# more than max(HEADCOUNT_TOLERANCE_MIN, HEADCOUNT_TOLERANCE_PERCENT % of the headcount).
HEADCOUNT_TOLERANCE_PERCENT=15
HEADCOUNT_TOLERANCE_MIN=3
HEADCOUNT_MAX=2000
HEADCOUNT_STALE_MINUTES=30
# Spot checks: default and maximum sample size, and how many previous sessions reduce re-selection.
SPOT_CHECK_DEFAULT_SIZE=5
SPOT_CHECK_MAX_SIZE=20
SPOT_CHECK_HISTORY_SESSIONS=2
# Each spot-check round also includes at least this many face-verified students, when any exist, so a
# face exception is not obvious from who gets checked.
SPOT_CHECK_FACE_VERIFIED_MIN=1

# Development only: allow the session cookie over plain HTTP. Refused when NODE_ENV=production.
ALLOW_INSECURE_COOKIES=false

# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Face-verification pilot (optional; the per-course flag is off by default, so these are unused until
# a course opts in). FACE_VERIFIER selects the implementation: "production" (a real vendor; the stub
# throws NOT_CONFIGURED until one is integrated) or "fake" (deterministic, for development and tests).
FACE_VERIFIER=production
# Key that encrypts the vendor template reference at rest (AES-256-GCM): 32+ bytes, base64url.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FACE_TEMPLATE_KEY=
# How long a supervised enrollment session stays open for the student (seconds, 60-3600).
FACE_ENROLLMENT_SESSION_TTL_SECONDS=300
# The privacy-notice version a student must have consented to before enrolling.
FACE_NOTICE_VERSION=2026-10-face-pilot-v1
# Face check: single-use challenge lifetime (s), match threshold (0-1), attempts before an in-person
# decision, and how long liveness/score detail is kept before the outcome alone remains.
FACE_CHALLENGE_TTL_SECONDS=90
FACE_MATCH_THRESHOLD=0.8
FACE_MAX_ATTEMPTS=5
FACE_DETAIL_RETENTION_DAYS=90
